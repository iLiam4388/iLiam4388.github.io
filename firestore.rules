rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =====================================================
    // HELPERS
    // =====================================================

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function admin() {
      return signedIn()
        && exists(
          /databases/$(database)/documents/admins/$(request.auth.uid)
        );
    }

    function ownsPost(postId) {
      return signedIn()
        && exists(
          /databases/$(database)/documents/posts/$(postId)
        )
        && get(
          /databases/$(database)/documents/posts/$(postId)
        ).data.uid == request.auth.uid;
    }

    // =====================================================
    // PROFILE VALIDATION
    // =====================================================

    function validProfile() {
      return request.resource.data.username is string
        && request.resource.data.nickname is string

        && request.resource.data.username.size() >= 3
        && request.resource.data.username.size() <= 20

        && request.resource.data.nickname.size() >= 1
        && request.resource.data.nickname.size() <= 24

        && request.resource.data.get('photoURL', '') is string;
    }

    // =====================================================
    // POST VALIDATION
    // =====================================================

    function validNewPost() {
      return signedIn()

        && request.resource.data.uid == request.auth.uid

        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 2000

        && request.resource.data.upvotes is int
        && request.resource.data.upvotes == 0

        && request.resource.data.featured is bool
        && request.resource.data.featured == false;
    }

    // =====================================================
    // COMMENT VALIDATION
    // =====================================================

    function validNewComment() {
      return signedIn()

        && request.resource.data.uid == request.auth.uid

        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 500

        && request.resource.data.likes is int
        && request.resource.data.likes == 0

        && (
          request.resource.data.get('parentId', null) == null
          || request.resource.data.get('parentId', null) is string
        );
    }

    // =====================================================
    // USER MARKERS
    // =====================================================

    function validUserMarker() {
      return signedIn()
        && request.resource.data.uid == request.auth.uid;
    }

    // =====================================================
    // ADMINS
    // =====================================================

    match /admins/{uid} {

      // A user can only check their own admin document.
      allow read: if isSelf(uid);

      // Admin status cannot be created from the client.
      allow write: if false;
    }

    // =====================================================
    // PROFILES
    // =====================================================

    match /profiles/{uid} {

      allow read: if signedIn();

      allow create: if isSelf(uid)
        && validProfile();

      allow update: if isSelf(uid)
        && validProfile();

      allow delete: if isSelf(uid)
        || admin();

      // ---------------------------------------------------
      // FOLLOWING
      // ---------------------------------------------------

      match /following/{targetUid} {

        allow read: if signedIn();

        allow create: if isSelf(uid)
          && targetUid != uid;

        allow delete: if isSelf(uid)
          && targetUid != uid;

        allow update: if false;
      }

      // ---------------------------------------------------
      // FOLLOWERS
      // ---------------------------------------------------

      match /followers/{followerUid} {

        allow read: if signedIn();

        allow create: if isSelf(followerUid)
          && followerUid != uid;

        allow delete: if isSelf(followerUid)
          && followerUid != uid;

        allow update: if false;
      }
    }

    // =====================================================
    // USERNAMES
    // =====================================================

    match /usernames/{username} {

      allow read: if signedIn();

      allow create: if signedIn()
        && validUserMarker();

      allow update: if false;

      allow delete: if signedIn()
        && (
          resource.data.uid == request.auth.uid
          || admin()
        );
    }

    // =====================================================
    // POSTS
    // =====================================================

    match /posts/{postId} {

      allow read: if signedIn();

      allow create: if validNewPost();

      // Normal users may ONLY increase the upvote count by 1.
      // Admins may update the post.
      allow update: if admin()
        || (
          signedIn()

          && request.resource.data
            .diff(resource.data)
            .affectedKeys()
            .hasOnly(['upvotes'])

          && request.resource.data.upvotes is int
          && resource.data.upvotes is int

          && request.resource.data.upvotes
            == resource.data.upvotes + 1
        );

      allow delete: if admin()
        || (
          signedIn()
          && resource.data.uid == request.auth.uid
        );

      // ---------------------------------------------------
      // POST VOTES
      // ---------------------------------------------------

      match /votes/{uid} {

        allow read: if signedIn();

        allow create: if isSelf(uid)
          && validUserMarker();

        allow update: if false;

        allow delete: if false;
      }

      // ---------------------------------------------------
      // COMMENTS
      // ---------------------------------------------------

      match /comments/{commentId} {

        allow read: if signedIn();

        allow create: if validNewComment();

        // Only likes may change.
        allow update: if signedIn()

          && request.resource.data
            .diff(resource.data)
            .affectedKeys()
            .hasOnly(['likes'])

          && request.resource.data.likes is int

          && request.resource.data.likes
            == resource.data.get('likes', 0) + 1;

        allow delete: if admin()
          || ownsPost(postId)
          || (
            signedIn()
            && resource.data.uid == request.auth.uid
          );

        // -----------------------------------------------
        // COMMENT LIKES
        // -----------------------------------------------

        match /likes/{uid} {

          allow read: if signedIn();

          allow create: if isSelf(uid)
            && validUserMarker();

          allow update: if false;

          allow delete: if false;
        }
      }
    }
  }
}