rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function hasProfile() {
      return signedIn()
        && exists(/databases/$(database)/documents/profiles/$(request.auth.uid));
    }

    function ownsPost(postId) {
      return signedIn()
        && exists(/databases/$(database)/documents/posts/$(postId))
        && get(/databases/$(database)/documents/posts/$(postId)).data.uid == request.auth.uid;
    }

    function validProfile() {
      return request.resource.data.keys().hasOnly([
          'username', 'nickname', 'photoURL', 'createdAt'
        ])
        && request.resource.data.username is string
        && request.resource.data.nickname is string
        && request.resource.data.photoURL is string
        && request.resource.data.username.size() >= 3
        && request.resource.data.username.size() <= 20
        && request.resource.data.nickname.size() >= 1
        && request.resource.data.nickname.size() <= 24
        && request.auth.token.email is string
        && request.auth.token.email == request.resource.data.username + '@users.iliam.app';
    }

    function validNewPost() {
      return hasProfile()
        && request.resource.data.keys().hasOnly([
          'uid', 'username', 'nickname', 'photoURL',
          'text', 'imageUrl', 'videoUrl', 'upvotes',
          'featured', 'createdAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username is string
        && request.resource.data.nickname is string
        && request.resource.data.photoURL is string
        && request.resource.data.text is string
        && request.resource.data.imageUrl is string
        && request.resource.data.videoUrl is string
        && request.resource.data.text.size() <= 2000
        && request.resource.data.upvotes is int
        && request.resource.data.upvotes == 0
        && request.resource.data.featured is bool
        && request.resource.data.featured == false;
    }

    function validNewComment() {
      return hasProfile()
        && request.resource.data.keys().hasOnly([
          'uid', 'username', 'nickname', 'text',
          'parentId', 'likes', 'createdAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username is string
        && request.resource.data.nickname is string
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 500
        && request.resource.data.likes is int
        && request.resource.data.likes == 0
        && (request.resource.data.parentId == null
          || request.resource.data.parentId is string);
    }

    function validMarker() {
      return request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid;
    }

    function validRelationship() {
      return request.resource.data.keys().hasOnly(['createdAt']);
    }

    function validGame() {
      return request.resource.data.keys().hasOnly([
          'name', 'url', 'image', 'description',
          'featured', 'enabled', 'order'
        ])
        && request.resource.data.name is string
        && request.resource.data.url is string
        && request.resource.data.image is string
        && request.resource.data.description is string
        && request.resource.data.featured is bool
        && request.resource.data.enabled is bool
        && request.resource.data.order is number;
    }

    match /admins/{uid} {
      // Admin membership is assigned manually in Firebase.
      allow read: if isSelf(uid);
      allow write: if false;
    }

    match /profiles/{uid} {
      allow read: if signedIn();

      allow create: if isSelf(uid) && validProfile();

      // The username is tied to the Firebase Auth login and cannot change.
      allow update: if isSelf(uid)
        && validProfile()
        && request.resource.data.username == resource.data.username
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['nickname', 'photoURL']);

      allow delete: if isSelf(uid) || isAdmin();

      match /following/{targetUid} {
        allow read: if signedIn();
        allow create: if isSelf(uid)
          && targetUid != uid
          && validRelationship();
        allow delete: if isAdmin()
          || ((isSelf(uid) || isSelf(targetUid)) && targetUid != uid);
        allow update: if false;
      }

      match /followers/{followerUid} {
        allow read: if signedIn();
        allow create: if isSelf(followerUid)
          && followerUid != uid
          && validRelationship();
        allow delete: if isAdmin()
          || ((isSelf(uid) || isSelf(followerUid)) && followerUid != uid);
        allow update: if false;
      }
    }

    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if validNewPost();

      // Admins can only feature/unfeature. Users can only add one upvote,
      // and that increment must be accompanied by their vote marker.
      allow update: if (
          isAdmin()
          && request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['featured'])
          && request.resource.data.featured is bool
        ) || (
          hasProfile()
          && request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['upvotes'])
          && resource.data.upvotes is int
          && request.resource.data.upvotes is int
          && request.resource.data.upvotes == resource.data.upvotes + 1
          && !exists(/databases/$(database)/documents/posts/$(postId)/votes/$(request.auth.uid))
          && existsAfter(/databases/$(database)/documents/posts/$(postId)/votes/$(request.auth.uid))
        );

      allow delete: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);

      match /votes/{uid} {
        allow read: if signedIn();
        allow create: if isSelf(uid)
          && hasProfile()
          && validMarker()
          && !exists(/databases/$(database)/documents/posts/$(postId)/votes/$(uid));
        allow update: if false;
        allow delete: if isAdmin();
      }

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if validNewComment();

        // A like increment must be paired with this user's new like marker.
        allow update: if hasProfile()
          && request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['likes'])
          && request.resource.data.likes is int
          && request.resource.data.likes == resource.data.get('likes', 0) + 1
          && !exists(/databases/$(database)/documents/posts/$(postId)/comments/$(commentId)/likes/$(request.auth.uid))
          && existsAfter(/databases/$(database)/documents/posts/$(postId)/comments/$(commentId)/likes/$(request.auth.uid));

        allow delete: if isAdmin()
          || ownsPost(postId)
          || (signedIn() && resource.data.uid == request.auth.uid);

        match /likes/{uid} {
          allow read: if signedIn();
          allow create: if isSelf(uid)
            && hasProfile()
            && validMarker()
            && !exists(/databases/$(database)/documents/posts/$(postId)/comments/$(commentId)/likes/$(uid));
          allow update: if false;
          allow delete: if isAdmin();
        }
      }
    }

    // Old username-reservation documents are no longer used by the app.
    // Admin read/delete exists only so Reset Community can clear leftovers.
    match /usernames/{username} {
      allow read, delete: if isAdmin();
      allow create, update: if false;
    }

    match /games/{gameId} {
      allow read: if true;

      // Kept compatible with the existing games page. A password embedded
      // in a static page cannot be securely enforced by Firestore Rules.
      allow create, update: if validGame();
      allow delete: if true;
    }
  }
}
