rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function hasProfile() {
      return signedIn()
        && exists(/databases/$(database)/documents/profiles/$(request.auth.uid));
    }

    function ownsPost(postId) {
      return signedIn()
        && exists(/databases/$(database)/documents/posts/$(postId))
        && get(/databases/$(database)/documents/posts/$(postId)).data.uid == request.auth.uid;
    }

    function validProfile() {
      return request.resource.data.keys().hasOnly([
          'username', 'nickname', 'photoURL', 'createdAt'
        ])
        && request.resource.data.username is string
        && request.resource.data.nickname is string
        && request.resource.data.photoURL is string
        && request.resource.data.username.size() >= 3
        && request.resource.data.username.size() <= 20
        && request.resource.data.nickname.size() >= 1
        && request.resource.data.nickname.size() <= 24
        && request.auth.token.email is string
        && request.auth.token.email == request.resource.data.username + '@users.iliam.app';
    }

    function validNewPost() {
      return hasProfile()
        && request.resource.data.keys().hasOnly([
          'uid', 'username', 'nickname', 'photoURL',
          'text', 'imageUrl', 'videoUrl', 'upvotes',
          'featured', 'createdAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username is string
        && request.resource.data.nickname is string
        && request.resource.data.photoURL is string
        && request.resource.data.text is string
        && request.resource.data.imageUrl is string
        && request.resource.data.videoUrl is string
        && request.resource.data.text.size() <= 2000
        && request.resource.data.upvotes is int
        && request.resource.data.upvotes == 0
        && request.resource.data.featured is bool
        && request.resource.data.featured == false;
    }

    function validNewComment() {
      return hasProfile()
        && request.resource.data.keys().hasOnly([
          'uid', 'username', 'nickname', 'text',
          'parentId', 'likes', 'createdAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username is string
        && request.resource.data.nickname is string
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 500
        && request.resource.data.likes is int
        && request.resource.data.likes == 0
        && (request.resource.data.parentId == null
          || request.resource.data.parentId is string);
    }

    function validMarker() {
      return request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid;
    }

    function validRelationship() {
      return request.resource.data.keys().hasOnly(['createdAt']);
    }

    function validGame() {
      return request.resource.data.keys().hasOnly([
          'name', 'url', 'image', 'description',
          'featured', 'enabled', 'order'
        ])
        && request.resource.data.name is string
        && request.resource.data.url is string
        && request.resource.data.image is string
        && request.resource.data.description is string
        && request.resource.data.featured is bool
        && request.resource.data.enabled is bool
        && request.resource.data.order is number;
    }

    match /admins/{uid} {
      // Membership alone grants authority. Cosmetic profile badges never do.
      // First admin is bootstrapped in Firebase Console, never by the client.
      allow read: if signedIn();
      allow create, update: if isAdmin();
      allow delete: if isAdmin() && !isSelf(uid);
    }

    // Full community administration, including nested comments, reaction
    // markers and follow records. Do not grant authority to unrelated data.
    // admins is intentionally excluded so self-removal cannot bypass its rule.
    match /{root}/{document=**} {
      allow read, write: if isAdmin()
        && root in ['profiles', 'posts', 'announcements', 'usernames', 'reviews'];
    }

    match /announcements/{announcementId} {
      // Sitewide announcements appear to visitors before login.
      allow read: if true;
    }

    match /profiles/{uid} {
      allow read: if signedIn();

      allow create: if isSelf(uid) && validProfile();

      // Admins can change public identity/add metadata. Ordinary users may
      // still edit nickname/photo without rewriting or gaining protected fields.
      allow update: if isSelf(uid)
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() >= 1
        && request.resource.data.nickname.size() <= 24
        && request.resource.data.photoURL is string
        && request.resource.data.username == resource.data.username
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['nickname', 'photoURL']);

      allow delete: if isSelf(uid) || isAdmin();

      match /following/{targetUid} {
        allow read: if signedIn();
        allow create: if isSelf(uid)
          && targetUid != uid
          && validRelationship();
        allow delete: if isAdmin()
          || ((isSelf(uid) || isSelf(targetUid)) && targetUid != uid);
        allow update: if false;
      }

      match /followers/{followerUid} {
        allow read: if signedIn();
        allow create: if isSelf(followerUid)
          && followerUid != uid
          && validRelationship();
        allow delete: if isAdmin()
          || ((isSelf(uid) || isSelf(followerUid)) && followerUid != uid);
        allow update: if false;
      }
    }

    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if validNewPost();

      // The scoped admin override above permits full editing. Users add one upvote,
      // and that increment must be accompanied by their vote marker.
      allow update: if (
          isAdmin()
          && request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['featured'])
          && request.resource.data.featured is bool
        ) || (
          hasProfile()
          && request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['upvotes'])
          && resource.data.upvotes is int
          && request.resource.data.upvotes is int
          && request.resource.data.upvotes == resource.data.upvotes + 1
          && !exists(/databases/$(database)/documents/posts/$(postId)/votes/$(request.auth.uid))
          && existsAfter(/databases/$(database)/documents/posts/$(postId)/votes/$(request.auth.uid))
        );

      allow delete: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);

      match /votes/{uid} {
        allow read: if signedIn();
        allow create: if isSelf(uid)
          && hasProfile()
          && validMarker()
          && !exists(/databases/$(database)/documents/posts/$(postId)/votes/$(uid));
        allow update: if false;
        allow delete: if isAdmin();
      }

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if validNewComment();

        // A like increment must be paired with this user's new like marker.
        allow update: if hasProfile()
          && request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['likes'])
          && request.resource.data.likes is int
          && request.resource.data.likes == resource.data.get('likes', 0) + 1
          && !exists(/databases/$(database)/documents/posts/$(postId)/comments/$(commentId)/likes/$(request.auth.uid))
          && existsAfter(/databases/$(database)/documents/posts/$(postId)/comments/$(commentId)/likes/$(request.auth.uid));

        allow delete: if isAdmin()
          || ownsPost(postId)
          || (signedIn() && resource.data.uid == request.auth.uid);

        match /likes/{uid} {
          allow read: if signedIn();
          allow create: if isSelf(uid)
            && hasProfile()
            && validMarker()
            && !exists(/databases/$(database)/documents/posts/$(postId)/comments/$(commentId)/likes/$(uid));
          allow update: if false;
          allow delete: if isAdmin();
        }
      }
    }

    // Old username-reservation documents are no longer used by the app.
    // Admin read/delete exists only so Reset Community can clear leftovers.
    match /usernames/{username} {
      allow read, delete: if isAdmin();
      allow create, update: if false;
    }

    // Reviews are publicly visible. Only a signed-in iLiam profile can write.
    function validReview() {
      return hasProfile()
        && request.resource.data.keys().hasOnly([
          'uid', 'username', 'nickname', 'text', 'rating', 'featured', 'createdAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username ==
          get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.username
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() > 0
        && request.resource.data.nickname.size() <= 24
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 1200
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.featured == false
        && request.resource.data.createdAt == request.time;
    }

    function validReply() {
      return hasProfile()
        && request.resource.data.keys().hasOnly([
          'uid', 'username', 'nickname', 'text', 'createdAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username ==
          get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.username
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() > 0
        && request.resource.data.nickname.size() <= 24
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 500
        && request.resource.data.createdAt == request.time;
    }

    function validReaction(reactionId) {
      return hasProfile()
        && request.resource.data.keys().hasOnly(['uid', 'emoji', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && (
          (reactionId == request.auth.uid + '_Like' && request.resource.data.emoji == '👍') ||
          (reactionId == request.auth.uid + '_Love' && request.resource.data.emoji == '❤️') ||
          (reactionId == request.auth.uid + '_Laugh' && request.resource.data.emoji == '😂')
        )
        && request.resource.data.createdAt == request.time;
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if validReview();
      allow update: if isAdmin();
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);

      match /reactions/{reactionId} {
        allow read: if true;
        allow create: if validReaction(reactionId);
        allow update: if false;
        allow delete: if isAdmin() ||
          (signedIn() && resource.data.uid == request.auth.uid);
      }

      match /replies/{replyId} {
        allow read: if true;
        allow create: if exists(/databases/$(database)/documents/reviews/$(reviewId))
          && validReply();
        allow update: if isAdmin();
        allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);

        match /reactions/{reactionId} {
          allow read: if true;
          allow create: if validReaction(reactionId);
          allow update: if false;
          allow delete: if isAdmin() ||
            (signedIn() && resource.data.uid == request.auth.uid);
        }
      }
    }


    // User-controlled call settings. Only the account owner can read/write.
    match /callSettings/{uid} {
      allow read: if isSelf(uid);
      allow create, update: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['doNotDisturb','updatedAt'])
        && request.resource.data.keys().hasAll(['doNotDisturb','updatedAt'])
        && request.resource.data.doNotDisturb is bool
        && request.resource.data.updatedAt == request.time;
      allow delete: if isSelf(uid);
    }

    // Private block list owned by the callee. A caller cannot read it,
    // but the calls creation rule can enforce it server-side.
    match /callBlocks/{ownerUid}/users/{blockedUid} {
      allow read: if isSelf(ownerUid);
      allow create: if isSelf(ownerUid)
        && blockedUid != ownerUid
        && request.resource.data.keys().hasOnly(['uid','blockedAt'])
        && request.resource.data.keys().hasAll(['uid','blockedAt'])
        && request.resource.data.uid == blockedUid
        && request.resource.data.blockedAt == request.time
        && exists(/databases/$(database)/documents/profiles/$(blockedUid));
      allow delete: if isSelf(ownerUid);
      allow update: if false;
    }

    function canReceiveCall(calleeUid, callerUid) {
      return !exists(/databases/$(database)/documents/callBlocks/$(calleeUid)/users/$(callerUid))
        && (!exists(/databases/$(database)/documents/callSettings/$(calleeUid))
          || get(/databases/$(database)/documents/callSettings/$(calleeUid)).data.doNotDisturb == false);
    }

    // Private one-to-one WebRTC signaling. Camera/microphone media never
    // goes into Firestore. A caller may invite a real iLiam profile.
    function callParticipant(callId) {
      return signedIn()
        && exists(/databases/$(database)/documents/calls/$(callId))
        && (
          get(/databases/$(database)/documents/calls/$(callId)).data.callerId == request.auth.uid
          || get(/databases/$(database)/documents/calls/$(callId)).data.calleeId == request.auth.uid
        );
    }

    function validCallOffer(value) {
      return value is map
        && value.keys().hasOnly(['type','sdp'])
        && value.type == 'offer'
        && value.sdp is string
        && value.sdp.size() > 0
        && value.sdp.size() <= 50000;
    }

    function validCallAnswer(value) {
      return value is map
        && value.keys().hasOnly(['type','sdp'])
        && value.type == 'answer'
        && value.sdp is string
        && value.sdp.size() > 0
        && value.sdp.size() <= 50000;
    }

    function validCallCandidate(callId, side) {
      return callParticipant(callId)
        && request.resource.data.keys().hasOnly([
          'uid','candidate','sdpMid','sdpMLineIndex','usernameFragment'
        ])
        && request.resource.data.keys().hasAll(['uid','candidate'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.uid == (
          side == 'caller'
          ? get(/databases/$(database)/documents/calls/$(callId)).data.callerId
          : get(/databases/$(database)/documents/calls/$(callId)).data.calleeId
        )
        && request.resource.data.candidate is string
        && request.resource.data.candidate.size() <= 8192
        && get(/databases/$(database)/documents/calls/$(callId)).data.status in ['ringing','accepted'];
    }

    match /calls/{callId} {
      allow get, list: if signedIn()
        && (resource.data.callerId == request.auth.uid
          || resource.data.calleeId == request.auth.uid);

      allow create: if hasProfile()
        && request.resource.data.keys().hasOnly([
          'callerId','calleeId','callerName','type','status','offer','createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'callerId','calleeId','callerName','type','status','offer','createdAt'
        ])
        && request.resource.data.callerId == request.auth.uid
        && request.resource.data.calleeId is string
        && request.resource.data.calleeId != request.auth.uid
        && exists(/databases/$(database)/documents/profiles/$(request.resource.data.calleeId))
        && canReceiveCall(request.resource.data.calleeId, request.auth.uid)
        && request.resource.data.callerName ==
          get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.nickname
        && request.resource.data.type in ['audio','video']
        && request.resource.data.status == 'ringing'
        && validCallOffer(request.resource.data.offer)
        && request.resource.data.createdAt == request.time;

      allow update: if signedIn()
        && (resource.data.callerId == request.auth.uid
          || resource.data.calleeId == request.auth.uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','answer'])
        && (
          // Only the recipient can accept with an answer.
          (request.auth.uid == resource.data.calleeId
           && resource.data.status == 'ringing'
           && request.resource.data.status == 'accepted'
           && canReceiveCall(resource.data.calleeId, resource.data.callerId)
           && request.resource.data.keys().hasAll(['answer'])
           && validCallAnswer(request.resource.data.answer))
          ||
          (request.auth.uid == resource.data.calleeId
           && resource.data.status == 'ringing'
           && request.resource.data.status == 'declined'
           && !('answer' in request.resource.data))
          ||
          (resource.data.status in ['ringing','accepted']
           && request.resource.data.status == 'ended'
           && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
        );
      allow delete: if false;

      match /callerCandidates/{candidateId} {
        allow read: if callParticipant(callId);
        allow create: if validCallCandidate(callId,'caller');
        allow update, delete: if false;
      }
      match /calleeCandidates/{candidateId} {
        allow read: if callParticipant(callId);
        allow create: if validCallCandidate(callId,'callee');
        allow update, delete: if false;
      }
    }

    match /games/{gameId} {
      allow read: if true;
      allow create, update: if isAdmin() && validGame();
      allow delete: if isAdmin();
    }
  }
}
