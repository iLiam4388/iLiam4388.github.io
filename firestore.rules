rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function hasProfile() {
      return signedIn()
        && exists(/databases/$(database)/documents/profiles/$(request.auth.uid));
    }

    function ownsPost(postId) {
      return signedIn()
        && exists(/databases/$(database)/documents/posts/$(postId))
        && get(/databases/$(database)/documents/posts/$(postId)).data.uid == request.auth.uid;
    }

    function validProfile() {
      return request.resource.data.keys().hasOnly([
          'username', 'nickname', 'photoURL', 'createdAt'
        ])
        && request.resource.data.username is string
        && request.resource.data.nickname is string
        && request.resource.data.photoURL is string
        && request.resource.data.username.size() >= 3
        && request.resource.data.username.size() <= 20
        && request.resource.data.nickname.size() >= 1
        && request.resource.data.nickname.size() <= 24
        && request.auth.token.email is string
        && request.auth.token.email == request.resource.data.username + '@users.iliam.app';
    }

    function validNewPost() {
      return hasProfile()
        && request.resource.data.keys().hasOnly([
          'uid', 'username', 'nickname', 'photoURL',
          'text', 'upvotes',
          'featured', 'createdAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username is string
        && request.resource.data.nickname is string
        && request.resource.data.photoURL is string
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 2000
        && request.resource.data.upvotes is int
        && request.resource.data.upvotes == 0
        && request.resource.data.featured is bool
        && request.resource.data.featured == false;
    }

    function validNewComment() {
      return hasProfile()
        && request.resource.data.keys().hasOnly([
          'uid', 'username', 'nickname', 'text',
          'parentId', 'likes', 'createdAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username is string
        && request.resource.data.nickname is string
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 500
        && request.resource.data.likes is int
        && request.resource.data.likes == 0
        && (request.resource.data.parentId == null
          || request.resource.data.parentId is string);
    }

    function validMarker() {
      return request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid;
    }

    function validRelationship() {
      return request.resource.data.keys().hasOnly(['createdAt']);
    }

    function validGame() {
      return request.resource.data.keys().hasOnly([
          'name', 'url', 'image', 'description',
          'featured', 'enabled', 'order'
        ])
        && request.resource.data.name is string
        && request.resource.data.url is string
        && request.resource.data.image is string
        && request.resource.data.description is string
        && request.resource.data.featured is bool
        && request.resource.data.enabled is bool
        && request.resource.data.order is number;
    }


    // Liam Coins: all balance changes and unlocks are checked server-side.
    function lcWallet(uid) {
      return /databases/$(database)/documents/liamWallets/$(uid);
    }
    function lcOwn(uid, item) {
      return exists(lcWallet(uid)) && item in get(lcWallet(uid)).data.owned;
    }
    function lcPrice(item, price) {
      return (item == 'follower' && price == 250)
          || (item == 'glasses' && price == 75)
          || (item == 'hat' && price == 75)
          || (item == 'purple' && price == 50)
          || (item == 'green' && price == 50)
          || (item == 'gold' && price == 100)
          || (item == 'frame' && price == 100)
          || (item == 'gradient' && price == 125)
          || (item == 'username' && price == 75)
          || (item == 'cursor' && price == 150)
          || (item == 'texture' && price == 150)
          || (item == 'tag' && price == 100)
          || (item == 'wallpaper' && price == 75);
    }
    function lcPost(uid, postId, featured) {
      return postId is string && postId.size() > 0 && postId.size() < 100
        && exists(/databases/$(database)/documents/posts/$(postId))
        && get(/databases/$(database)/documents/posts/$(postId)).data.uid == uid
        && (!featured || get(/databases/$(database)/documents/posts/$(postId)).data.featured == true);
    }
    match /liamWallets/{uid} {
      allow read: if isSelf(uid);
      allow create: if isSelf(uid) && hasProfile()
        && request.resource.data.keys().hasOnly(['balance','owned','claims','action','postId'])
        && request.resource.data.balance == 100
        && request.resource.data.owned == []
        && request.resource.data.claims == []
        && request.resource.data.action == 'starter'
        && request.resource.data.postId == '';
      allow update: if isSelf(uid) && hasProfile()
        && request.resource.data.keys().hasOnly(['balance','owned','claims','action','postId'])
        && request.resource.data.balance is int && request.resource.data.balance >= 0
        && request.resource.data.owned is list && request.resource.data.claims is list
        && (
          (request.resource.data.claims == resource.data.claims
            && !(request.resource.data.action in resource.data.owned)
            && request.resource.data.owned == resource.data.owned.concat([request.resource.data.action])
            && request.resource.data.postId == ''
            && lcPrice(request.resource.data.action, resource.data.balance - request.resource.data.balance))
          || (request.resource.data.owned == resource.data.owned
            && request.resource.data.action in ['firstPost','featured']
            && !(request.resource.data.action in resource.data.claims)
            && request.resource.data.claims == resource.data.claims.concat([request.resource.data.action])
            && lcPost(uid, request.resource.data.postId, request.resource.data.action == 'featured')
            && request.resource.data.balance == resource.data.balance + (request.resource.data.action == 'featured' ? 150 : 25))
        );
      allow delete: if false;
    }
    function lcAppearance(uid) {
      let c = request.resource.data.liamAppearance;
      return c is map && c.keys().hasOnly(['avatar','color','glasses','hat','follower','frame','gradient','username','cursor','texture','tag'])
        && c.keys().hasAll(['avatar','color','glasses','hat','follower','frame','gradient','username','cursor','texture','tag'])
        && c.avatar is bool
        && (c.color == 'blue' || (c.color in ['purple','green','gold'] && lcOwn(uid,c.color)))
        && c.glasses is bool && (!c.glasses || lcOwn(uid,'glasses'))
        && c.hat is bool && (!c.hat || lcOwn(uid,'hat'))
        && c.follower is bool && (!c.follower || lcOwn(uid,'follower'))
        && c.frame is bool && (!c.frame || lcOwn(uid,'frame'))
        && c.gradient is bool && (!c.gradient || lcOwn(uid,'gradient'))
        && c.username is bool && (!c.username || lcOwn(uid,'username'))
        && c.cursor is bool && (!c.cursor || lcOwn(uid,'cursor'))
        && c.texture is bool && (!c.texture || lcOwn(uid,'texture'))
        && c.tag is bool && (!c.tag || lcOwn(uid,'tag'));
    }
    match /profiles/{uid} {
      allow update: if isSelf(uid) && hasProfile()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['liamAppearance'])
        && lcAppearance(uid);
    }

    match /admins/{uid} {
      // Membership alone grants authority. Cosmetic profile badges never do.
      // First admin is bootstrapped in Firebase Console, never by the client.
      allow read: if signedIn();
      allow create, update: if isAdmin();
      allow delete: if isAdmin() && !isSelf(uid);
    }

    // Full community administration, including nested comments, reaction
    // markers and follow records. Do not grant authority to unrelated data.
    // admins is intentionally excluded so self-removal cannot bypass its rule.
    match /{root}/{document=**} {
      allow read, write: if isAdmin()
        && root in ['profiles', 'posts', 'announcements', 'usernames', 'reviews'];
    }

    // Public navigation badges; only real administrators may change them.
    match /navBadges/{page} {
      allow read: if true;
      allow create, update: if isAdmin()
        && page in ['videos', 'photos', 'downloads', 'community', 'store', 'games', 'other']
        && request.resource.data.keys().hasAll(['enabled', 'text'])
        && request.resource.data.keys().hasOnly(['enabled', 'text', 'endsAt'])
        && (request.resource.data.get('endsAt', null) == null || request.resource.data.endsAt is timestamp)
        && request.resource.data.enabled is bool
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 80;
      allow delete: if isAdmin();
    }

    match /announcements/{announcementId} {
      // Sitewide announcements appear to visitors before login.
      allow read: if true;
    }

    match /profiles/{uid} {
      allow read: if signedIn();

      allow create: if isSelf(uid) && validProfile();

      // Admins can change public identity/add metadata. Ordinary users may
      // still edit nickname/photo without rewriting or gaining protected fields.
      allow update: if isSelf(uid)
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() >= 1
        && request.resource.data.nickname.size() <= 24
        && request.resource.data.photoURL is string
        && request.resource.data.username == resource.data.username
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['nickname', 'photoURL', 'hidePostingGuidance', 'notificationSettings', 'notificationDefaultsVersion'])
        && request.resource.data.get('notificationDefaultsVersion', 2) == 2
        && request.resource.data.get('hidePostingGuidance', false) is bool
        && request.resource.data.get('notificationSettings', {'announcements': false, 'votes': false}) is map
        && request.resource.data.get('notificationSettings', {'announcements': false, 'votes': false}).keys().hasOnly(['announcements', 'votes'])
        && request.resource.data.get('notificationSettings', {'announcements': false, 'votes': false}).get('announcements', false) is bool
        && request.resource.data.get('notificationSettings', {'announcements': false, 'votes': false}).get('votes', false) is bool;

      allow delete: if isSelf(uid) || isAdmin();

      match /savedPosts/{postId} {
        allow read: if isSelf(uid);
        allow create: if isSelf(uid)
          && postId.size() > 0 && postId.size() <= 150
          && request.resource.data.keys().hasOnly(['savedAt'])
          && request.resource.data.savedAt == request.time;
        allow delete: if isSelf(uid);
        allow update: if false;
      }

      match /following/{targetUid} {
        allow read: if signedIn();
        allow create: if isSelf(uid)
          && targetUid != uid
          && validRelationship();
        allow delete: if isAdmin()
          || ((isSelf(uid) || isSelf(targetUid)) && targetUid != uid);
        allow update: if false;
      }

      match /followers/{followerUid} {
        allow read: if signedIn();
        allow create: if isSelf(followerUid)
          && followerUid != uid
          && validRelationship();
        allow delete: if isAdmin()
          || ((isSelf(uid) || isSelf(followerUid)) && followerUid != uid);
        allow update: if false;
      }
    }

    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if validNewPost();

      // The scoped admin override above permits full editing. Users add one upvote,
      // and that increment must be accompanied by their vote marker.
      allow update: if (
          isAdmin()
          && request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['featured'])
          && request.resource.data.featured is bool
        ) || (
          hasProfile()
          && request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['upvotes'])
          && resource.data.upvotes is int
          && request.resource.data.upvotes is int
          && request.resource.data.upvotes == resource.data.upvotes + 1
          && !exists(/databases/$(database)/documents/posts/$(postId)/votes/$(request.auth.uid))
          && existsAfter(/databases/$(database)/documents/posts/$(postId)/votes/$(request.auth.uid))
        );

      allow delete: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);

      match /votes/{uid} {
        allow read: if signedIn();
        allow create: if isSelf(uid)
          && hasProfile()
          && validMarker()
          && !exists(/databases/$(database)/documents/posts/$(postId)/votes/$(uid));
        allow update: if false;
        allow delete: if isAdmin();
      }

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if validNewComment();

        // A like increment must be paired with this user's new like marker.
        allow update: if hasProfile()
          && request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['likes'])
          && request.resource.data.likes is int
          && request.resource.data.likes == resource.data.get('likes', 0) + 1
          && !exists(/databases/$(database)/documents/posts/$(postId)/comments/$(commentId)/likes/$(request.auth.uid))
          && existsAfter(/databases/$(database)/documents/posts/$(postId)/comments/$(commentId)/likes/$(request.auth.uid));

        allow delete: if isAdmin()
          || ownsPost(postId)
          || (signedIn() && resource.data.uid == request.auth.uid);

        match /likes/{uid} {
          allow read: if signedIn();
          allow create: if isSelf(uid)
            && hasProfile()
            && validMarker()
            && !exists(/databases/$(database)/documents/posts/$(postId)/comments/$(commentId)/likes/$(uid));
          allow update: if false;
          allow delete: if isAdmin();
        }
      }
    }

    // Old username-reservation documents are no longer used by the app.
    // Admin read/delete exists only so Reset Community can clear leftovers.
    match /usernames/{username} {
      allow read, delete: if isAdmin();
      allow create, update: if false;
    }

    // Reviews are publicly visible. Only a signed-in iLiam profile can write.
    function validReview() {
      return hasProfile()
        && request.resource.data.keys().hasOnly([
          'uid', 'username', 'nickname', 'text', 'rating', 'featured', 'createdAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username ==
          get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.username
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() > 0
        && request.resource.data.nickname.size() <= 24
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 1200
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.featured == false
        && request.resource.data.createdAt == request.time;
    }

    function validReply() {
      return hasProfile()
        && request.resource.data.keys().hasOnly([
          'uid', 'username', 'nickname', 'text', 'createdAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username ==
          get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.username
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() > 0
        && request.resource.data.nickname.size() <= 24
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 500
        && request.resource.data.createdAt == request.time;
    }

    function validReaction(reactionId) {
      return hasProfile()
        && request.resource.data.keys().hasOnly(['uid', 'emoji', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && (
          (reactionId == request.auth.uid + '_Like' && request.resource.data.emoji == '👍') ||
          (reactionId == request.auth.uid + '_Love' && request.resource.data.emoji == '❤️') ||
          (reactionId == request.auth.uid + '_Laugh' && request.resource.data.emoji == '😂')
        )
        && request.resource.data.createdAt == request.time;
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if validReview();
      allow update: if isAdmin();
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);

      match /reactions/{reactionId} {
        allow read: if true;
        allow create: if validReaction(reactionId);
        allow update: if false;
        allow delete: if isAdmin() ||
          (signedIn() && resource.data.uid == request.auth.uid);
      }

      match /replies/{replyId} {
        allow read: if true;
        allow create: if exists(/databases/$(database)/documents/reviews/$(reviewId))
          && validReply();
        allow update: if isAdmin();
        allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);

        match /reactions/{reactionId} {
          allow read: if true;
          allow create: if validReaction(reactionId);
          allow update: if false;
          allow delete: if isAdmin() ||
            (signedIn() && resource.data.uid == request.auth.uid);
        }
      }
    }


    // User-controlled call settings. Only the account owner can read/write.
    match /callSettings/{uid} {
      allow read: if isSelf(uid);
      allow create, update: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['doNotDisturb','updatedAt'])
        && request.resource.data.keys().hasAll(['doNotDisturb','updatedAt'])
        && request.resource.data.doNotDisturb is bool
        && request.resource.data.updatedAt == request.time;
      allow delete: if isSelf(uid);
    }

    // Private block list owned by the callee. A caller cannot read it,
    // but the calls creation rule can enforce it server-side.
    match /callBlocks/{ownerUid}/users/{blockedUid} {
      allow read: if isSelf(ownerUid);
      allow create: if isSelf(ownerUid)
        && blockedUid != ownerUid
        && request.resource.data.keys().hasOnly(['uid','blockedAt'])
        && request.resource.data.keys().hasAll(['uid','blockedAt'])
        && request.resource.data.uid == blockedUid
        && request.resource.data.blockedAt == request.time
        && exists(/databases/$(database)/documents/profiles/$(blockedUid));
      allow delete: if isSelf(ownerUid);
      allow update: if false;
    }

    function canReceiveCall(calleeUid, callerUid) {
      return !exists(/databases/$(database)/documents/callBlocks/$(calleeUid)/users/$(callerUid))
        && !exists(/databases/$(database)/documents/callBlocks/$(callerUid)/users/$(calleeUid))
        && (!exists(/databases/$(database)/documents/callSettings/$(calleeUid))
          || get(/databases/$(database)/documents/callSettings/$(calleeUid)).data.doNotDisturb == false);
    }

    // Private one-to-one WebRTC signaling. Camera/microphone media never
    // goes into Firestore. A caller may invite a real iLiam profile.
    function callParticipant(callId) {
      return signedIn()
        && exists(/databases/$(database)/documents/calls/$(callId))
        && (
          get(/databases/$(database)/documents/calls/$(callId)).data.callerId == request.auth.uid
          || get(/databases/$(database)/documents/calls/$(callId)).data.calleeId == request.auth.uid
        );
    }

    function validCallOffer(value) {
      return value is map
        && value.keys().hasOnly(['type','sdp'])
        && value.type == 'offer'
        && value.sdp is string
        && value.sdp.size() > 0
        && value.sdp.size() <= 50000;
    }

    function validCallAnswer(value) {
      return value is map
        && value.keys().hasOnly(['type','sdp'])
        && value.type == 'answer'
        && value.sdp is string
        && value.sdp.size() > 0
        && value.sdp.size() <= 50000;
    }

    function validCallCandidate(callId, side) {
      return callParticipant(callId)
        && request.resource.data.keys().hasOnly([
          'uid','candidate','sdpMid','sdpMLineIndex','usernameFragment'
        ])
        && request.resource.data.keys().hasAll(['uid','candidate'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.uid == (
          side == 'caller'
          ? get(/databases/$(database)/documents/calls/$(callId)).data.callerId
          : get(/databases/$(database)/documents/calls/$(callId)).data.calleeId
        )
        && request.resource.data.candidate is string
        && request.resource.data.candidate.size() <= 8192
        && get(/databases/$(database)/documents/calls/$(callId)).data.status in ['ringing','accepted'];
    }

    match /calls/{callId} {
      allow get, list: if signedIn()
        && (resource.data.callerId == request.auth.uid
          || resource.data.calleeId == request.auth.uid);

      allow create: if hasProfile()
        && request.resource.data.keys().hasOnly([
          'callerId','calleeId','callerName','type','status','offer','createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'callerId','calleeId','callerName','type','status','offer','createdAt'
        ])
        && request.resource.data.callerId == request.auth.uid
        && request.resource.data.calleeId is string
        && request.resource.data.calleeId != request.auth.uid
        && exists(/databases/$(database)/documents/profiles/$(request.resource.data.calleeId))
        && canReceiveCall(request.resource.data.calleeId, request.auth.uid)
        && request.resource.data.callerName ==
          get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.nickname
        && request.resource.data.type in ['audio','video']
        && request.resource.data.status == 'ringing'
        && validCallOffer(request.resource.data.offer)
        && request.resource.data.createdAt == request.time;

      allow update: if signedIn()
        && (resource.data.callerId == request.auth.uid
          || resource.data.calleeId == request.auth.uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','answer'])
        && (
          // Only the recipient can accept with an answer.
          (request.auth.uid == resource.data.calleeId
           && resource.data.status == 'ringing'
           && request.resource.data.status == 'accepted'
           && canReceiveCall(resource.data.calleeId, resource.data.callerId)
           && request.resource.data.keys().hasAll(['answer'])
           && validCallAnswer(request.resource.data.answer))
          ||
          (request.auth.uid == resource.data.calleeId
           && resource.data.status == 'ringing'
           && request.resource.data.status == 'declined'
           && !('answer' in request.resource.data))
          ||
          (resource.data.status in ['ringing','accepted']
           && request.resource.data.status == 'ended'
           && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
        );
      allow delete: if false;

      match /callerCandidates/{candidateId} {
        allow read: if callParticipant(callId);
        allow create: if validCallCandidate(callId,'caller');
        allow update, delete: if false;
      }
      match /calleeCandidates/{candidateId} {
        allow read: if callParticipant(callId);
        allow create: if validCallCandidate(callId,'callee');
        allow update, delete: if false;
      }
    }


    // Temporary group calls (2-4 accounts total). The host invites each
    // person separately so DND/block checks apply to every invitation.
    function groupMember(roomId, uid) {
      return exists(/databases/$(database)/documents/groupCalls/$(roomId)/members/$(uid))
        && get(/databases/$(database)/documents/groupCalls/$(roomId)/members/$(uid)).data.status == 'accepted';
    }
    function groupParticipant(roomId) {
      return signedIn()
        && exists(/databases/$(database)/documents/groupCalls/$(roomId))
        && request.auth.uid in get(/databases/$(database)/documents/groupCalls/$(roomId)).data.participants;
    }
    function groupRoomOpen(roomId) {
      return groupParticipant(roomId)
        && get(/databases/$(database)/documents/groupCalls/$(roomId)).data.status == 'open';
    }
    match /groupCalls/{roomId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if hasProfile()
        && request.resource.data.keys().hasOnly(['hostId','hostName','participants','type','status','createdAt'])
        && request.resource.data.keys().hasAll(['hostId','hostName','participants','type','status','createdAt'])
        && request.resource.data.hostId == request.auth.uid
        && request.resource.data.hostName ==
          get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.nickname
        && request.resource.data.participants is list
        && request.resource.data.participants.size() >= 2
        && request.resource.data.participants.size() <= 4
        && request.resource.data.participants[0] == request.auth.uid
        && request.resource.data.participants.toSet().size() ==
          request.resource.data.participants.size()
        && request.resource.data.type in ['audio','video']
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn() && resource.data.hostId == request.auth.uid
        && resource.data.status == 'open'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status == 'ended';
      allow delete: if false;

      match /members/{uid} {
        allow read: if groupParticipant(roomId);
        allow create: if groupRoomOpen(roomId)
          && uid in get(/databases/$(database)/documents/groupCalls/$(roomId)).data.participants
          && request.resource.data.keys().hasOnly(['uid','status','updatedAt'])
          && request.resource.data.keys().hasAll(['uid','status','updatedAt'])
          && request.resource.data.uid == uid
          && request.resource.data.updatedAt == request.time
          && (
            (uid == request.auth.uid
              && uid == get(/databases/$(database)/documents/groupCalls/$(roomId)).data.hostId
              && request.resource.data.status == 'accepted')
            ||
            (request.auth.uid == get(/databases/$(database)/documents/groupCalls/$(roomId)).data.hostId
              && uid != request.auth.uid
              && request.resource.data.status == 'ringing'
              && exists(/databases/$(database)/documents/profiles/$(uid))
              && canReceiveCall(uid, request.auth.uid))
          );
        allow update: if groupRoomOpen(roomId) && uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.updatedAt == request.time
          && (
            (resource.data.status == 'ringing'
              && (
                request.resource.data.status == 'declined'
                || (request.resource.data.status == 'accepted'
                  && canReceiveCall(uid,
                    get(/databases/$(database)/documents/groupCalls/$(roomId)).data.hostId))
              ))
            ||
            (resource.data.status == 'accepted'
              && request.resource.data.status == 'left')
          );
        allow delete: if false;
      }

      match /connections/{connectionId} {
        allow read: if groupParticipant(roomId);
        allow create: if groupRoomOpen(roomId)
          && request.resource.data.keys().hasOnly(['a','b','offer','createdAt'])
          && request.resource.data.keys().hasAll(['a','b','offer','createdAt'])
          && request.resource.data.a == request.auth.uid
          && request.resource.data.a is string
          && request.resource.data.b is string
          && request.resource.data.a != request.resource.data.b
          && connectionId == request.resource.data.a + '__' + request.resource.data.b
          && request.resource.data.b in get(/databases/$(database)/documents/groupCalls/$(roomId)).data.participants
          && groupMember(roomId, request.resource.data.a)
          && groupMember(roomId, request.resource.data.b)
          && !exists(/databases/$(database)/documents/callBlocks/$(request.resource.data.a)/users/$(request.resource.data.b))
          && !exists(/databases/$(database)/documents/callBlocks/$(request.resource.data.b)/users/$(request.resource.data.a))
          && validCallOffer(request.resource.data.offer)
          && request.resource.data.createdAt == request.time;
        allow update: if groupRoomOpen(roomId)
          && request.auth.uid == resource.data.b
          && groupMember(roomId, resource.data.b)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answer'])
          && !('answer' in resource.data)
          && validCallAnswer(request.resource.data.answer);
        allow delete: if false;

        match /aCandidates/{candidateId} {
          allow read: if groupParticipant(roomId);
          allow create: if groupRoomOpen(roomId)
            && exists(/databases/$(database)/documents/groupCalls/$(roomId)/connections/$(connectionId))
            && request.auth.uid == get(/databases/$(database)/documents/groupCalls/$(roomId)/connections/$(connectionId)).data.a
            && request.resource.data.keys().hasOnly(['uid','candidate','sdpMid','sdpMLineIndex','usernameFragment'])
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.candidate is string
          && request.resource.data.candidate.size() <= 8192;
          allow update, delete: if false;
        }
        match /bCandidates/{candidateId} {
          allow read: if groupParticipant(roomId);
          allow create: if groupRoomOpen(roomId)
            && exists(/databases/$(database)/documents/groupCalls/$(roomId)/connections/$(connectionId))
            && request.auth.uid == get(/databases/$(database)/documents/groupCalls/$(roomId)/connections/$(connectionId)).data.b
            && request.resource.data.keys().hasOnly(['uid','candidate','sdpMid','sdpMLineIndex','usernameFragment'])
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.candidate is string
          && request.resource.data.candidate.size() <= 8192;
          allow update, delete: if false;
        }
      }
    }


    // Authenticated, member-only one-to-one and 3–4-person chats.
    function chatMember(chatId) {
      return signedIn()
        && exists(/databases/$(database)/documents/chats/$(chatId))
        && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
    }
    function chatUsersExist(members) {
      return exists(/databases/$(database)/documents/profiles/$(members[0]))
        && exists(/databases/$(database)/documents/profiles/$(members[1]))
        && (members.size() < 3
          || exists(/databases/$(database)/documents/profiles/$(members[2])))
        && (members.size() < 4
          || exists(/databases/$(database)/documents/profiles/$(members[3])));
    }
    function validChatImage(v) {
      return v is string && v.size() <= 120000
        && (v == '' || v.matches('^https://[^ ]+$')
          || v.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$'));
    }
    function dmAllowed(m) {
      return m.size() != 2
        || (!exists(/databases/$(database)/documents/messageBlocks/$(m[0])/users/$(m[1]))
          && !exists(/databases/$(database)/documents/messageBlocks/$(m[1])/users/$(m[0])));
    }
    match /messagePreferences/{uid} {
      match /hidden/{chatId} {
        allow read: if isSelf(uid);
        allow create, update: if isSelf(uid)
          && request.resource.data.keys().hasOnly(['hiddenAt'])
          && request.resource.data.hiddenAt == request.time;
        allow delete: if isSelf(uid);
      }
      // Per-account chat history cutoff. Clearing does not erase another user's messages.
      match /cleared/{chatId} {
        allow read: if isSelf(uid);
        allow create, update: if isSelf(uid)
          && request.resource.data.keys().hasOnly(['clearedAt'])
          && request.resource.data.keys().hasAll(['clearedAt'])
          && request.resource.data.clearedAt == request.time;
        allow delete: if isSelf(uid);
      }
      match /settings/{id} {
        allow read: if isSelf(uid);
        allow create, update: if isSelf(uid) && id == 'messages'
          && request.resource.data.keys().hasOnly(['doNotDisturb','updatedAt'])
          && request.resource.data.keys().hasAll(['doNotDisturb','updatedAt'])
          && request.resource.data.doNotDisturb is bool
          && request.resource.data.updatedAt == request.time;
        allow delete: if isSelf(uid);
      }
    }
    match /messageBlocks/{uid}/users/{blockedUid} {
      allow read: if isSelf(uid);
      allow create: if isSelf(uid) && blockedUid != uid
        && exists(/databases/$(database)/documents/profiles/$(blockedUid))
        && request.resource.data.keys().hasOnly(['uid','blockedAt'])
        && request.resource.data.keys().hasAll(['uid','blockedAt'])
        && request.resource.data.uid == blockedUid
        && request.resource.data.blockedAt == request.time;
      allow delete: if isSelf(uid);
      allow update: if false;
    }

    // One public conversation. All participants must be genuine iLiam users.
    match /publicChatMessages/{messageId} {
      allow read: if hasProfile();
      allow create: if hasProfile()
        && request.resource.data.keys().hasOnly(['uid','text','createdAt','replyTo'])
        && request.resource.data.keys().hasAll(['uid','text','createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 2000
        && request.resource.data.createdAt == request.time
        && (!('replyTo' in request.resource.data)
          || (request.resource.data.replyTo is map
            && request.resource.data.replyTo.keys().hasOnly(['id','uid','text'])
            && request.resource.data.replyTo.keys().hasAll(['id','uid','text'])
            && request.resource.data.replyTo.id is string
            && request.resource.data.replyTo.id.size() > 0
            && request.resource.data.replyTo.id.size() <= 150
            && request.resource.data.replyTo.uid is string
            && request.resource.data.replyTo.text is string
            && request.resource.data.replyTo.text.size() <= 180
            && exists(/databases/$(database)/documents/publicChatMessages/$(request.resource.data.replyTo.id))
            && get(/databases/$(database)/documents/publicChatMessages/$(request.resource.data.replyTo.id)).data.uid == request.resource.data.replyTo.uid));
      allow update: if false;
      allow delete: if isAdmin() || (hasProfile() && resource.data.uid == request.auth.uid);
    }

    match /chats/{chatId} {
      allow get, list: if signedIn()
        && request.auth.uid in resource.data.members;
      allow create: if hasProfile()
        && request.resource.data.keys().hasOnly([
          'members','kind','title','createdBy','createdAt','imageUrl'
        ])
        && request.resource.data.keys().hasAll([
          'members','kind','title','createdBy','createdAt'
        ])
        && request.resource.data.members is list
        && request.resource.data.members.size() >= 2
        && request.resource.data.members.size() <= 4
        && request.resource.data.members[0] == request.auth.uid
        && request.resource.data.members.toSet().size() ==
          request.resource.data.members.size()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.kind in ['direct','group']
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 60
        && (!('imageUrl' in request.resource.data) || validChatImage(request.resource.data.imageUrl))
        && (
          (request.resource.data.kind == 'direct'
            && request.resource.data.members.size() == 2
            && chatId.matches('^dm_[A-Za-z0-9_-]+$'))
          ||
          (request.resource.data.kind == 'group'
            && request.resource.data.members.size() >= 3
            && request.resource.data.members.size() <= 4
            && request.resource.data.title.size() >= 1
            && chatId.matches('^group_[A-Za-z0-9_-]+$'))
        )
        && chatUsersExist(request.resource.data.members);
      // Members can edit the name/photo; only the creator may add or
      // remove members. Creator must stay in a group; maximum four total.
      allow update: if signedIn()
        && request.auth.uid in resource.data.members
        && resource.data.kind == 'group'
        && resource.data.get('deleting', false) == false
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['title','imageUrl','members'])
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.kind == resource.data.kind
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1
        && request.resource.data.title.size() <= 60
        && (!('imageUrl' in request.resource.data) || validChatImage(request.resource.data.imageUrl))
        && request.resource.data.members is list
        && request.resource.data.members.size() >= 2
        && request.resource.data.members.size() <= 4
        && request.resource.data.members.toSet().size() ==
          request.resource.data.members.size()
        && request.resource.data.createdBy in request.resource.data.members
        && (
          request.resource.data.members == resource.data.members
          || (
            request.auth.uid == resource.data.createdBy
            && chatUsersExist(request.resource.data.members)
          )
        );
      // A member reopening an existing conversation makes it visible again
      // to participants who had hidden the older conversation.
      allow update: if signedIn()
        && request.auth.uid in resource.data.members
        && resource.data.get('deleting', false) == false
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['revivedAt'])
        && request.resource.data.revivedAt == request.time;
      // Deletion is shared: freeze new messages first, then delete all
      // message documents and finally the chat itself.
      allow update: if signedIn()
        && request.auth.uid in resource.data.members
        && resource.data.get('deleting', false) == false
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['deleting', 'deletionStartedAt'])
        && request.resource.data.deleting == true
        && request.resource.data.deletionStartedAt == request.time;
      allow delete: if signedIn()
        && request.auth.uid in resource.data.members
        && resource.data.get('deleting', false) == true;

      match /messages/{messageId} {
        allow read: if chatMember(chatId);
        allow create: if chatMember(chatId)
          && get(/databases/$(database)/documents/chats/$(chatId)).data.get('deleting', false) == false
          && dmAllowed(get(/databases/$(database)/documents/chats/$(chatId)).data.members)
          && request.resource.data.keys().hasOnly(['uid','text','createdAt','replyTo'])
          && request.resource.data.keys().hasAll(['uid','text','createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 2000
          && request.resource.data.createdAt == request.time
          && (!('replyTo' in request.resource.data)
            || (request.resource.data.replyTo is map
              && request.resource.data.replyTo.keys().hasOnly(['id','uid','text'])
              && request.resource.data.replyTo.keys().hasAll(['id','uid','text'])
              && request.resource.data.replyTo.id is string
              && request.resource.data.replyTo.id.size() > 0
              && request.resource.data.replyTo.id.size() <= 150
              && request.resource.data.replyTo.uid is string
              && request.resource.data.replyTo.text is string
              && request.resource.data.replyTo.text.size() <= 180
              && exists(/databases/$(database)/documents/chats/$(chatId)/messages/$(request.resource.data.replyTo.id))
              && get(/databases/$(database)/documents/chats/$(chatId)/messages/$(request.resource.data.replyTo.id)).data.uid == request.resource.data.replyTo.uid));
        allow update: if false;
        allow delete: if chatMember(chatId)
          && (resource.data.uid == request.auth.uid
            || get(/databases/$(database)/documents/chats/$(chatId)).data.get('deleting', false) == true);
      }
    }

    // Shared iLiam Whiteboard rooms use unguessable 128-bit invite codes.
    // Only signed-in iLiam accounts can read/edit a known room. Board
    // discovery/listing is disabled; anyone with a shared code may edit.
    function validWhiteboardColor(c) {
      return c is string && c.matches('^#[0-9a-fA-F]{6}$');
    }
    function validWhiteboardTitle(t) {
      return t is string && t.size() >= 1 && t.size() <= 60;
    }
    function validWhiteboardElement() {
      return hasProfile()
        && request.resource.data.keys().hasOnly([
          'kind','x','y','x2','y2','color','width','opacity',
          'points','text','createdBy','createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'kind','x','y','x2','y2','color','width','opacity',
          'points','text','createdBy','createdAt'
        ])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.kind in [
          'pen','highlighter','line','rect','ellipse','arrow','text','sticky'
        ]
        && validWhiteboardColor(request.resource.data.color)
        && request.resource.data.width is number
        && request.resource.data.width >= 1
        && request.resource.data.width <= 40
        && request.resource.data.opacity is number
        && request.resource.data.opacity >= 0.05
        && request.resource.data.opacity <= 1
        && request.resource.data.x is number
        && request.resource.data.y is number
        && request.resource.data.x2 is number
        && request.resource.data.y2 is number
        && request.resource.data.points is list
        && request.resource.data.points.size() <= 240
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 250;
    }

    // Shared whiteboards: invite-only or link access. Pre-existing rooms
    // without accessMode retain their old signed-in-by-link behavior.
    function boardViewAccess(data) {
      return data.get('accessMode','legacy') == 'link'
        || (signedIn() && (
          data.get('accessMode','legacy') == 'legacy'
          || data.ownerId == request.auth.uid
          || request.auth.uid in data.get('invitedUids', [])
        ));
    }
    function boardEditAccess(data) {
      return hasProfile() && (
        data.get('accessMode','legacy') in ['link','legacy']
        || data.ownerId == request.auth.uid
        || request.auth.uid in data.get('invitedUids', [])
      );
    }
    function validBoardSharing(data) {
      return data.get('accessMode','') in ['restricted','link']
        && data.get('invitedUids',null) is list
        && data.invitedUids.size() <= 20
        && data.invitedUids.toSet().size() == data.invitedUids.size()
        && !(data.ownerId in data.invitedUids);
    }
    function canSeeBoard(boardId) {
      return exists(/databases/$(database)/documents/whiteboards/$(boardId))
        && boardViewAccess(get(/databases/$(database)/documents/whiteboards/$(boardId)).data);
    }
    function canEditBoard(boardId) {
      return exists(/databases/$(database)/documents/whiteboards/$(boardId))
        && boardEditAccess(get(/databases/$(database)/documents/whiteboards/$(boardId)).data);
    }
    match /whiteboards/{boardId} {
      allow get: if boardViewAccess(resource.data);
      // Only owner/invitee queries can list boards. Public-link rooms
      // remain unlisted, even when anyone with their URL can view them.
      allow list: if signedIn() && (
        resource.data.ownerId == request.auth.uid
        || request.auth.uid in resource.data.get('invitedUids', [])
      );
      allow create: if hasProfile()
        && boardId.matches('^[0-9a-f]{32}$')
        && request.resource.data.keys().hasOnly([
          'ownerId','title','paperColor','createdAt','accessMode','invitedUids'
        ])
        && request.resource.data.keys().hasAll([
          'ownerId','title','paperColor','createdAt','accessMode','invitedUids'
        ])
        && request.resource.data.ownerId == request.auth.uid
        && validWhiteboardTitle(request.resource.data.title)
        && validWhiteboardColor(request.resource.data.paperColor)
        && validBoardSharing(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if hasProfile()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['title','paperColor','accessMode','invitedUids'])
        && validWhiteboardTitle(request.resource.data.title)
        && validWhiteboardColor(request.resource.data.paperColor)
        && (
          // Preserve edits to existing legacy boards without silently
          // changing their access permissions.
          (!('accessMode' in request.resource.data)
            && !('invitedUids' in request.resource.data))
          || validBoardSharing(request.resource.data)
        );
      // Only the owner can delete a board after removing its drawings.
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
      match /elements/{elementId} {
        allow get, list: if canSeeBoard(boardId);
        allow create: if canEditBoard(boardId)
          && elementId.matches('^[0-9a-f]{32}$')
          && validWhiteboardElement();
        allow update: if false;
        allow delete: if canEditBoard(boardId);
      }
    }

    match /games/{gameId} {
      allow read: if true;
      allow create, update: if isAdmin() && validGame();
      allow delete: if isAdmin();
    }
  }
}
// Firestore rules deployment managed by GitHub Actions (iLiam).
